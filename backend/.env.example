# PackCheck Backend Environment Configuration (Example - Placeholders Only)
PROJECT_NAME=PackCheck
ENVIRONMENT=development
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# MySQL Database Configuration (Placeholders - DO NOT COMMIT REAL CREDENTIALS)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=packcheck_db

# JWT & Security Configuration (Placeholders)
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
