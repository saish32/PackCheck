    "machine_checks": [
        {
            "id": "R3_SCOPE",
            "rule_no": "3",
            "description": "Determine whether Chapter II retail-package requirements apply before evaluating them."
        },
        {
            "id": "R4_CORE_DECLARATION_PRESENT",
            "rule_no": "4",
            "description": "For packages leaving manufacturer premises, required declarations must be present; bonded-warehouse allowance is contextual."
        },
        {
            "id": "R6_DECLARATIONS",
            "rule_no": "6",
            "description": "Evaluate applicable mandatory declarations and special commodity-sector overrides."
        },
        {
            "id": "R6_ECOM_ORIGIN_FILTER",
            "rule_no": "6(10A)",
            "effective_from": "2026-07-01",
            "expires_or_replaced": "2027-07-01",
            "description": "For imported products offered for sale by an e-commerce entity, require the effective searchable/sortable country-of-origin filter rule."
        },
        {
            "id": "R7_LETTER_HEIGHT",
            "rule_no": "7",
            "description": "Use current PDP table only when physical scale calibration is available; otherwise REVIEW_REQUIRED."
        },
        {
            "id": "R8_PDP_PLACEMENT",
            "rule_no": "8",
            "description": "Check spatial placement and separation around the net-quantity declaration where image geometry is adequate."
        },
        {
            "id": "R9_PRESENTATION",
            "rule_no": "9",
            "description": "Check legibility/presentation/contrast/language using evidence; ambiguous image quality must not become a false failure."
        },
        {
            "id": "R10_ADDRESS",
            "rule_no": "10",
            "description": "Check manufacturer/packer/importer identity/address context, including approved shorter-address exception."
        },
        {
            "id": "R11_QUANTITY",
            "rule_no": "11",
            "description": "Compare declared quantity and measured quantity only when a valid inspector/instrument measurement is supplied."
        },
        {
            "id": "R12_QUANTITY_MODE",
            "rule_no": "12",
            "description": "Select weight/measure/number from commodity type and Fourth Schedule overrides."
        },
        {
            "id": "R13_UNITS",
            "rule_no": "13",
            "description": "Validate the statement of units and subunit choice."
        },
        {
            "id": "R14_DIMENSIONS",
            "rule_no": "14",
            "description": "Commodity-specific dimension declarations where applicable."
        },
        {
            "id": "R15_DIMENSION_WEIGHT",
            "rule_no": "15",
            "description": "Cases where price/quantity relationship requires additional dimension/weight declaration."
        },
        {
            "id": "R16_SHEETS",
            "rule_no": "16",
            "description": "Sheet packages require usable-sheet count and dimensions where applicable."
        },
        {
            "id": "R17_CONTAINER",
            "rule_no": "17",
            "description": "Container-type commodity quantity/dimensions declarations where applicable."
        },
        {
            "id": "R18_SALE_PRICE",
            "rule_no": "18",
            "description": "Transaction-stage check only when observed sale price is provided; lower-than-MRP sale is not itself a violation."
        },
        {
            "id": "R19_21_INSPECTION_TEST",
            "rule_no": "19/21",
            "description": "Capture lot, sample and verified measurement evidence for inspector-led quantity testing."
        },
        {
            "id": "R22_MPE",
            "rule_no": "22",
            "description": "Apply First Schedule maximum permissible error to verified measurements."
        },
        {
            "id": "R23_DECEPTIVE",
            "rule_no": "23",
            "description": "Produce only a potential deceptive-package design signal; do not declare deception from CV alone."
        },
        {
            "id": "R24_WHOLESALE",
            "rule_no": "24",
            "description": "Apply wholesale-package declarations when package type is wholesale."
        },
        {
            "id": "R25_EXPORT",
            "rule_no": "25",
            "description": "For export packages encountered in domestic sale context, require domestic conformity before automated conclusion."
        },
        {
            "id": "R26_EXEMPTIONS",
            "rule_no": "26",
            "description": "Apply current exemptions before downstream checks; uncertain exemption status routes to review."
        },
        {
            "id": "R27_REGISTRATION",
            "rule_no": "27",
            "description": "Check registration evidence only when registry/certificate context is supplied; package image alone cannot prove registration."
        },
        {
            "id": "R28_SHORT_ADDRESS",
            "rule_no": "28",
            "description": "Accept shorter address only when registration/permission evidence is provided."
        },
        {
            "id": "R31_ADVERTISEMENT",
            "rule_no": "31",
            "description": "Optional advertisement inspection: if advertisement mentions retail sale price, net quantity/number and font relationship can be checked."
        },
        {
            "id": "R33_RELAXATION",
            "rule_no": "33",
            "description": "Apply a documented relaxation only from authoritative approval evidence and within its conditions/time window."
        }
    ],
    "sector_overrides": {
        "food": "LMPC Rule 6 food-specific portions may defer to FSS Act/rules where expressly stated; PackCheck must label cross-regulatory coverage and must not claim complete FSSAI compliance.",
        "cosmetic": "LMPC Rule 6 expressly routes certain manufacture/date matters to the Drugs and Cosmetics Rules; do not apply conflicting LMPC assumptions.",
        "seed": "LMPC Rule 6 contains an explicit seed-labeling exception for manufacture-date provision where Seeds Act certification applies.",
        "alcohol": "Retail-sale-price declaration is subject to applicable State Excise law where provided.",
        "medical_device": "Since 2025-10-24, MDR 2017 governs the applicable declaration/letter-height/width rules for packages containing medical devices; PackCheck must not apply ordinary LMPC font metrics as a final result.",
        "tobacco": "Rule 26(a) small-package exemption is restricted; tobacco and tobacco products are not to be assumed exempt.",
        "pan_masala": "From 2026-02-01, the Rule 26(a) small-package exemption is restricted for pan masala; do not treat a <=10 g/ml pan-masala package as exempt under that clause."
    }
